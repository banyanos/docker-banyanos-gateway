# Copy to .env and replace every REPLACE value before deployment.
# Keep .env private. This template contains no working credentials.
# deploy.sh can instead generate .env and the seed JSON with random passwords.

# Configuration is read directly from env/se-configdata.local.json at startup.
SETTING_SOURCE=json

# Default: install platform modules from requirements-silvaengine.txt (main).
# Banyanos engines/provider plugins remain mounted from BANYAN_MODULES_DIR.
# Plain docker compose up loads the source build through docker-compose.override.yml.
GATEWAY_IMAGE=banyanos-gateway:local
# Path to this project's parent (contains engine and llm_provider_* repositories).
# Relative paths resolve from docker-banyanos-gateway.
BANYAN_MODULES_DIR=..
# GitHub private key for private platform repositories (BuildKit secret only).
SSH_PRIVATE_KEY_FILE=./.ssh/id_ed25519
# Required pip index for image builds; choose your mirror.
PIP_INDEX_URL=https://pypi.org/simple/
DOCKER_MIRROR_PREFIX=docker.io/library/

# Published host ports; container-to-container ports and URLs stay unchanged.
GATEWAY_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
DYNAMODB_HOST_PORT=8001
# PG_PORT below is the internal container port. For host-side tools, set their
# PG_HOST=localhost and PG_PORT to POSTGRES_HOST_PORT instead.

# Banyan uses module authentication: /auth/token delegates login to user_engine.
# Other supported providers: local (gateway accounts) and cognito.
GATEWAY_AUTH_PROVIDER=module
GATEWAY_AUTH_MODULE_DISPATCH=user_engine.main:dispatch_graphql
# Used only with GATEWAY_AUTH_PROVIDER=cognito (requires real AWS credentials):
# COGNITO_USER_POOL_ID=REPLACEUserPoolId
# COGNITO_APP_CLIENT_ID=REPLACEAppClientId
# COGNITO_APP_SECRET=REPLACEAppSecret
# COGNITO_JWKS_URL=https://cognito-idp.REGION.amazonaws.com/POOL/.well-known/jwks.json
# JWT verification options; leave JWT_SECRET_KEY unset to use the shared JWT_SECRET /
# jwt_secret from se-configdata, keeping gateway and engine tokens aligned.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP=15
# The following accounts/token options apply only to local auth:
# LOCAL_USER_FILE=/app/modules/path/to/users.json
# ADMIN_STATIC_TOKEN=REPLACEAdminToken

# Tenant and host-side E2E login; use an administrator provisioned in user_engine.
# ADMIN_USERNAME / ADMIN_PASSWORD configure gateway accounts only in local mode.
TENANT_PART_ID=nestaging
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACEAdminPassword

# Infrastructure credentials. Use distinct random alphanumeric passwords when
# using deploy.sh (its seed renderer requires alphanumeric configuration).
POSTGRES_USER=banyan
POSTGRES_PASSWORD=REPLACEPostgresPassword
POSTGRES_DB=banyan
NEO4J_AUTH=neo4j/REPLACENeo4jPassword
REDIS_PASSWORD=REPLACERedisPassword

# Gateway/database tooling and host E2E compatibility.
# Keep PG_USER / PG_PASSWORD / PG_DB equal to the POSTGRES_* values above.
# Use localhost for PG_HOST when running tools on the host; postgres in Docker.
# Application data backend: postgresql or dynamodb (AWS DynamoDB).
# This choice is independent of the JSON configuration source above.
db_backend=postgresql
PG_HOST=postgres
PG_PORT=5432
PG_USER=banyan
PG_PASSWORD=REPLACEPostgresPassword
PG_DB=banyan
# Keep this equal to the password portion of NEO4J_AUTH.
NEO4J_PASSWORD=REPLACENeo4jPassword

# No configuration database or initializer is required for JSON loading.
# For db_backend=dynamodb, supply real AWS credentials for application data.
# The following credentials are placeholders for PostgreSQL-only local use.
region_name=us-west-2
aws_access_key_id=local
aws_secret_access_key=local

# Host E2E/runtime secrets: match your seeded configuration where applicable.
# deploy.sh generates JWT/x-api-key values in env/se-configdata.local.json;
# it does not populate these .env values. Keep them synchronized when used.
JWT_SECRET=REPLACEJwtSecret
ENV_API_KEY=REPLACEApiKey
KEY_MASTER=REPLACEKeyMaster

# Optional runtime overrides (Compose defaults shown).
# ENDPOINT_ID=banyan
# ADAPTER_STAGE=beta
# ADAPTER_AREA=core
# SILVAENGINE_CACHE_TTL=300
# BANYAN_LOOPBACK_BASE_URL=http://127.0.0.1:8000/beta/core/banyan
# CAPABILITY_MCP_GATEWAY_BASE_URL=http://127.0.0.1:8000

# Addon repositories: mounted read-only at /app/extra_modules (default ./www/projects).
# Point EXTRA_MODULES_DIR at any host directory of module checkouts;
# list one /app/extra_modules/<repo> entry per repo in EXTRA_PYTHONPATH
# (colon-separated for multiple). Comment out when unused.
#EXTRA_MODULES_DIR=./www/projects
#EXTRA_PYTHONPATH=

# Framework repositories: mounted read-only at /app/src (default ./www/projects).
# Set SILVAENGINE_SRC to enable local framework imports; unset/empty uses installed main.
# Plain docker compose up -d then imports local framework code before installed packages.
# Leave unset/empty to use platform modules installed from main.
# SILVAENGINE_SRC=./www/projects
# To refresh installed main versions: docker compose build --no-cache gateway
