# Secrets & local config — never commit
.env
.ssh/*
!.ssh/.gitkeep

# Editor
.vscode/

# Runtime state (keep the dirs, drop the contents)
backups/
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# Bundled DB host bind mounts (Neo4j / PostgreSQL / Redis data + logs)
neo4j_data/
postgres_data/
postgres_logs/
redis_data/

# Misc
*.bak
__pycache__/
*.pyc

!.dockerignore
.claude

env/*.json
/.ssh/

# Local source workspace — keep directory markers, ignore cloned repositories.
www/*
!www/.gitkeep
!www/projects/
www/projects/*
!www/projects/.gitkeep
